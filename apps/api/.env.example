# ReviewLens API configuration.
# Copy to apps/api/.env and fill in real values. Never commit apps/api/.env.
# Every variable here is validated at startup (src/config/env.ts).

# Port the API listens on.
PORT=3000

# Origin of the web app. Used for CORS and Clerk authorizedParties.
WEB_ORIGIN=http://localhost:5173

# SECRET. Local database from docker-compose.yml (run: npm run db:up).
DATABASE_URL=postgresql://reviewlens:reviewlens@localhost:5432/reviewlens

# SECRET. Clerk Dashboard > Configure > API keys > Secret key (starts with sk_).
CLERK_SECRET_KEY=sk_test_replace_me

# Public by Clerk's design. Same dashboard page > Publishable key (starts with pk_).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# SECRET. SerpApi dashboard > API key. Server-side only; never log request URLs.
SERPAPI_API_KEY=replace_me

# Maximum reviews collected in one ingestion run (each SerpApi page costs one search).
MAX_REVIEWS_PER_RUN=50

# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
