# ReviewLens API configuration.
# Copy to apps/api/.env and fill in real values. Never commit apps/api/.env.
# Every variable here is validated at startup (src/config/env.ts).

# Port the API listens on.
PORT=3000

# Origin of the web app. Used for CORS and Clerk authorizedParties.
WEB_ORIGIN=http://localhost:5173

# SECRET. Local database from docker-compose.yml (run: npm run db:up).
DATABASE_URL=postgresql://reviewlens:reviewlens@localhost:5432/reviewlens

# SECRET. Clerk Dashboard > Configure > API keys > Secret key (starts with sk_).
CLERK_SECRET_KEY=sk_test_replace_me

# Public by Clerk's design. Same dashboard page > Publishable key (starts with pk_).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# SECRET. SerpApi dashboard > API key. Server-side only; never log request URLs.
SERPAPI_API_KEY=replace_me

# Maximum reviews collected in one ingestion run (each SerpApi page costs one search).
MAX_REVIEWS_PER_RUN=50

# SECRET. Google AI Studio > API Keys > Create API key (docs/qa-llm-provider.md).
# Use your own Google project; free-tier limits are per project. Server-side only.
GEMINI_API_KEY=replace_me

# Gemini model for Q&A. Use a stable (non-preview) model listed in Google AI Studio.
LLM_MODEL=gemini-3.5-flash-lite

# Give up on a Gemini request after this many milliseconds.
LLM_TIMEOUT_MS=30000

# How much Gemini 3 models reason before answering: minimal, low, medium, high.
# "low" keeps answers fast. Use "off" for Gemini 2.5 models, which don't support it.
LLM_THINKING_LEVEL=minimal

# Estimated tokens of review context sent per question (docs/qa-context.md).
QA_CONTEXT_TOKEN_BUDGET=40000

# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
