# ReviewLens web configuration.
# Copy to apps/web/.env and fill in values. Never commit apps/web/.env.
# Only values designed to be public may go here. NEVER put a secret key in this file.

# Base URL of the ReviewLens API.
VITE_API_BASE_URL=http://localhost:3000

# Public by Clerk's design. Clerk Dashboard > Configure > API keys > Publishable key (pk_...).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
